      "port": 8190,
      "auth": { "enabled": true, "auth_users": ["admin"] },
      "args": [],
      "resources": { "reserve_vram_gb": 8 }
    },
    {
      "name": "cpu",
      "description": "纯 CPU 推理, 支持认证(与性能模式解耦)",
      "access": "inner",
      "port": 8191,
      "auth": { "enabled": true, "auth_users": ["admin"] },
      "args": ["--cpu"],
      "resources": { "reserve_memory_mb": 2048 }
    },
    {
      "name": "cpu-public",
      "description": "纯 CPU, 公开访问, 支持认证",
      "access": "public",
      "port": 8192,
      "auth": { "enabled": true, "auth_users": ["admin"] },
